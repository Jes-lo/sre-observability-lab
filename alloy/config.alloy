logging {
  level  = "info"
  format = "logfmt"
}

loki.source.file "api" {
  targets = [
    {
      "__path__"    = "/var/log/sre-api/api.log",
      "service"     = "sre-api",
      "environment" = "local",
    },
  ]

  forward_to = [
    loki.process.api.receiver,
  ]
}

loki.process "api" {
  stage.json {
    expressions = {
      timestamp        = "time",
      level            = "level",
      event            = "event",
      request_id       = "req.id",
      method           = "req.method",
      url              = "req.url",
      status_code      = "res.statusCode",
      response_time_ms = "responseTime",
      trace_id         = "trace_id",
      span_id          = "span_id",
      trace_flags      = "trace_flags",
    }
  }

  stage.timestamp {
    source            = "timestamp"
    format            = "UnixMs"
    action_on_failure = "skip"
  }

  stage.structured_metadata {
    values = {
      level            = "level",
      event            = "event",
      request_id       = "request_id",
      method           = "method",
      url              = "url",
      status_code      = "status_code",
      response_time_ms = "response_time_ms",
      trace_id         = "trace_id",
      span_id          = "span_id",
      trace_flags      = "trace_flags",
    }
  }

  forward_to = [
    loki.write.local.receiver,
  ]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

otelcol.receiver.otlp "api_traces" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [
      otelcol.processor.batch.api_traces.input,
    ]
  }
}

otelcol.processor.batch "api_traces" {
  output {
    traces = [
      otelcol.exporter.otlp.tempo.input,
    ]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
